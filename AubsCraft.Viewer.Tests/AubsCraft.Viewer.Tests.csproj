<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<!-- A Windows-only gate (job objects, System.Drawing, the installed Chrome): CA1416 is not a finding here. -->
		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="NUnit" Version="4.3.2" />
		<PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
		<PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
		<!-- Pixel statistics and image comparison of the screenshots (the gate runs on Windows). -->
		<PackageReference Include="System.Drawing.Common" Version="9.0.6" />
	</ItemGroup>

	<ItemGroup>
		<!-- Same job object the server tests use: the published server and Chrome die with the test host, however it exits. -->
		<Compile Include="..\AubsCraft.Admin.Server.Tests\Live\KillOnExitJob.cs" Link="KillOnExitJob.cs" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="NUnit.Framework" />
	</ItemGroup>

</Project>
