<Project Sdk="Microsoft.NET.Sdk">

	<!-- Run: dotnet run (project AubsCraft.AssetTool) with arguments  version 1.21.5  out AubsCraft.Admin/wwwroot/assets
	     Writes mc-blocks.json, mc-atlas.rgba, mc-atlas.png, mc-entities.json, mc-entity-atlas.rgba and mc-assets-report.txt from the version's client jar (found, cached or downloaded). -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\AubsCraft.Assets\AubsCraft.Assets.csproj" />
	</ItemGroup>

</Project>
