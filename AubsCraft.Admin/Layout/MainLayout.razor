@inherits LayoutComponentBase
@inject AuthStateProvider Auth
@inject NavigationManager Nav
@inject ServerHubClient Hub
@inject RenderWorkerHost MapWorker
@implements IDisposable

@if (!_authChecked)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <p class="text-muted">Loading...</p>
    </div>
}
else if (Auth.IsAuthenticated)
{
    <NotificationToast />
    <ChatPanel />
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <ServerPicker />
                    <span class="text-muted">
                        @Auth.Username
                        @if (!string.IsNullOrEmpty(Auth.Role))
                        {
                            <span class="badge ms-2 @RoleBadgeClass">@Auth.Role</span>
                        }
                    </span>
                </div>
                <div class="d-flex gap-2">
                    <ThemeToggle />
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LogoutAsync">Logout</button>
                </div>
            </div>

            @* Keyed by the selected server: switching servers re-creates the page, so it loads that server's data
               from scratch (no page has to track the switch itself). *@
            <article class="content px-4" @key="Hub.SelectedServerId">
                @Body
            </article>
        </main>
    </div>
}
else if (IsPublicRoute)
{
    @* Anonymous users on a public route: render content only, no sidebar, no redirect. *@
    <div class="container py-3">
        <div class="d-flex justify-content-end mb-2">
            <a href="/login" class="btn btn-sm btn-outline-secondary">Sign In / Sign Up</a>
        </div>
        @Body
    </div>
}
else
{
    @* Redirect handled in OnInitializedAsync / location-changed *@
}

@code {
    // Routes that anonymous visitors are allowed to view without being redirected to /login.
    private static readonly string[] PublicRoutes = { "/play", "/pc" };

    private bool _authChecked;
    private bool IsPublicRoute => PublicRoutes.Any(route =>
        Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/').Equals(route.TrimStart('/'), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        Hub.OnSelectedServerChanged += OnSelectedServerChanged;
        await Auth.CheckAuthAsync();
        if (Auth.IsAuthenticated)
        {
            // Connect (and learn the server list + selection) BEFORE the first page renders, so pages start
            // on the right server instead of mounting once with no server and again when it arrives.
            try { await Hub.ConnectAsync(); }
            catch (Exception ex) { Console.WriteLine($"[MainLayout] Hub connect failed: {ex.Message}"); }
        }
        _authChecked = true;
        RedirectIfPrivate();
    }

    private void OnSelectedServerChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Re-check on navigation: a logged-out user navigating from /play to /map should bounce to /login.
        RedirectIfPrivate();
        InvokeAsync(StateHasChanged);
    }

    private void RedirectIfPrivate()
    {
        if (!_authChecked) return;
        if (Auth.IsAuthenticated) return;
        if (IsPublicRoute) return;
        Nav.NavigateTo("/login");
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        // Close everything the login cookie opened: the hub connection and the map worker's world WebSocket.
        await Hub.DisconnectAsync();
        await MapWorker.ResetAsync();
        Nav.NavigateTo("/login");
    }

    private string RoleBadgeClass => Auth.Role switch
    {
        "Owner" => "bg-warning text-dark",
        "Admin" => "bg-primary",
        "Friend" => "bg-info text-dark",
        _ => "bg-secondary",
    };

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Hub.OnSelectedServerChanged -= OnSelectedServerChanged;
    }
}
