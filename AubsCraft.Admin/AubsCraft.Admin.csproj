<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>
		<!-- Not compression needed -->
		<CompressionEnabled>false</CompressionEnabled>
		<WasmEnableThreads>false</WasmEnableThreads>
		<!-- AOT: the render loop, cave culling and chunk processing run in .NET every frame; interpreted they are
		     roughly 2x slower (Anaglyphohol measured 43.8 -> 21.7 ms/frame). WasmStripILAfterAOT=false keeps the IL
		     that ILGPU compiles kernels from. WasmDedup=false compiles generic instances per assembly in parallel
		     (Anaglyphohol: 65 min -> 5 min build, same runtime speed, larger dotnet.native.wasm). -->
		<RunAOTCompilation>true</RunAOTCompilation>
		<WasmStripILAfterAOT>false</WasmStripILAfterAOT>
		<WasmDedup>false</WasmDedup>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
		<!-- SpawnJS 3.0.4 reads records (no parameterless ctor) through their constructor - RenderStats from the render worker (3.0.1-3.0.3
		     do not: the stats line went blank). SpawnJS.Blazor >= 3.0.2 is what SpawnDev.GameUI 1.1.0 requires. -->
		<PackageReference Include="SpawnDev.SpawnJS" Version="3.0.4" />
		<PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="3.0.4" />
		<PackageReference Include="SpawnDev.SpawnJS.WebWorkers" Version="2.2.1" />
		<!-- 5.3.7 (released): includes the WGSL/GLSL early-return structurizer fix that 5.3.2-local.6 carried (MinecraftLODKernel hung
		     compiling on 5.0.0-5.3.1) and the >8-argument launcher fix SpawnDev.VoxelEngine's ColumnMesher kernels need. -->
		<PackageReference Include="SpawnDev.ILGPU" Version="5.3.7" />
		<!-- The viewer's renderer: BlockRenderPipeline + ColumnMesher + HeightmapMesher (a release candidate: the library's other subsystems are still RC) -->
		<PackageReference Include="SpawnDev.VoxelEngine" Version="0.2.0-rc.4" />
		<!-- ADB over WebUSB for the /quest installer (the SpawnJS edition of BlazorJS.TangoADB) -->
		<PackageReference Include="SpawnDev.SpawnJS.TangoADB" Version="1.0.0" />
		<!-- GameUI without a DOM (Init + PushedInputProvider) for the worker HUD, plus the chat-feed options -->
		<PackageReference Include="SpawnDev.GameUI" Version="1.1.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- The admin client runs only in the browser (SpawnJS, WebGPU, WebUSB). -->
		<AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
			<_Parameter1>browser</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SpawnDev.Rcon\SpawnDev.Rcon.csproj" />
		<ProjectReference Include="..\AubsCraft.Assets.Model\AubsCraft.Assets.Model.csproj" />
		<ProjectReference Include="..\AubsCraft.Live.Model\AubsCraft.Live.Model.csproj" />
	</ItemGroup>

	<!-- The block textures, models and animations come from the game's own client jar, of the version the servers run: generated here at build
	     time (a download from Mojang the first time, cached after) and never committed. The target runs before the build collects its static
	     assets, and only when the output is missing or the generator or this file changed. -->
	<PropertyGroup>
		<McAssetVersion>1.21.5</McAssetVersion>
		<McAssetsDir>$(MSBuildProjectDirectory)\wwwroot\assets</McAssetsDir>
	</PropertyGroup>
	<ItemGroup>
		<McAssetInputs Include="$(MSBuildProjectDirectory)\..\AubsCraft.Assets\**\*.cs;$(MSBuildProjectDirectory)\..\AubsCraft.Assets.Model\**\*.cs;$(MSBuildProjectDirectory)\..\AubsCraft.AssetTool\**\*.cs;$(MSBuildProjectDirectory)\..\AubsCraft.Live.Model\Entities\**\*.cs;$(MSBuildProjectFullPath)" Exclude="**\obj\**;**\bin\**" />
	</ItemGroup>
	<Target Name="GenerateMinecraftAssets" BeforeTargets="Restore;BeforeBuild;ResolveStaticWebAssetsInputs" Inputs="@(McAssetInputs)" Outputs="$(McAssetsDir)\mc-blocks.json;$(McAssetsDir)\mc-entities.json;$(McAssetsDir)\mc-entity-atlas.rgba">
		<Message Importance="high" Text="Generating the block assets for Minecraft $(McAssetVersion) into $(McAssetsDir)" />
		<Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\AubsCraft.AssetTool\AubsCraft.AssetTool.csproj&quot; -c Release -- --version $(McAssetVersion) --out &quot;$(McAssetsDir)&quot;" />
	</Target>

</Project>
