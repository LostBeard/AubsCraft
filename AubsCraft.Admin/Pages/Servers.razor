@page "/servers"
@inject ServerHubClient Hub
@inject AuthStateProvider Auth
@implements IDisposable

<PageTitle>Servers - AubsCraft Admin</PageTitle>

<h1>Servers</h1>

@if (!Auth.IsOwner)
{
    <div class="alert alert-warning">Only the owner can manage servers.</div>
}
else
{
    <div class="list-group mb-4">
        @foreach (var s in Hub.Servers)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <span class="server-dot @(s.Connected ? "online" : "offline") me-2"></span>
                    <strong>@s.Name</strong>
                    <span class="text-muted ms-2">@s.Loader @s.GameVersion</span>
                    @if (s.IsPrimary) { <span class="badge bg-secondary ms-2">players arrive here</span> }
                </div>
                <div class="text-muted small d-flex align-items-center gap-2">
                    <span><code>/server @s.Id</code> &middot; @(s.Connected ? $"{s.Online}/{s.Max} online" : "offline") &middot; @((s.MemoryMb / 1024.0).ToString("0.#")) GB</span>
                    <button class="btn btn-sm @(_manage == s.Id ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => ToggleManageAsync(s.Id)">
                        <span class="bi bi-gear"></span> Manage
                    </button>
                </div>
            </div>
            @if (_manage == s.Id)
            {
                <div class="list-group-item bg-body-tertiary">
                    @* Backups *@
                    <div class="d-flex align-items-center mb-2">
                        <strong>Backups</strong>
                        <span class="text-muted small ms-2">A running server keeps running while it is backed up.</span>
                        <button class="btn btn-sm btn-primary ms-auto" @onclick="() => StartAsync(Hub.BackupServerAsync(s.Id))" disabled="@_running">
                            <span class="bi bi-archive"></span> Back up now
                        </button>
                    </div>
                    @if (_backups.Count == 0)
                    {
                        <p class="text-muted small">No backups yet.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-3">
                                <thead><tr><th>Taken</th><th>Why</th><th>Size</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var b in _backups)
                                    {
                                        <tr>
                                            <td class="text-nowrap">@b.CreatedUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                                            <td>@BackupReason(s.Id, b.FileName)</td>
                                            <td class="text-nowrap">@Size(b.SizeBytes)</td>
                                            <td class="text-end text-nowrap">
                                                <a class="btn btn-sm btn-outline-secondary" href="@($"api/servers/{s.Id}/backups/{Uri.EscapeDataString(b.FileName)}")" download="@b.FileName" title="Download">
                                                    <span class="bi bi-download"></span>
                                                </a>
                                                @if (_confirm == "restore:" + b.FileName)
                                                {
                                                    <button class="btn btn-sm btn-warning" @onclick="() => StartAsync(Hub.RestoreBackupAsync(s.Id, b.FileName))" disabled="@_running">Yes, restore</button>
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirm = null">Cancel</button>
                                                }
                                                else if (_confirm == "delete:" + b.FileName)
                                                {
                                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteBackupAsync(s.Id, b.FileName)" disabled="@_running">Yes, delete</button>
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirm = null">Cancel</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-warning" @onclick="@(() => _confirm = "restore:" + b.FileName)" disabled="@_running" title="Put the server back to this backup">
                                                        <span class="bi bi-arrow-counterclockwise"></span> Restore
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="@(() => _confirm = "delete:" + b.FileName)" disabled="@_running" title="Delete this backup">
                                                        <span class="bi bi-trash"></span>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (_confirm?.StartsWith("restore:") == true)
                        {
                            <div class="alert alert-warning small py-2">Restoring stops @s.Name (players are moved off), replaces its files with the backup, and starts it again. Anything built since that backup is lost - back up first if you want to keep it.</div>
                        }
                    }

                    @* New world *@
                    <div class="border-top pt-3 mb-3">
                        <strong>New world</strong>
                        <div class="text-muted small mb-2">Starts @s.Name over with a fresh world. Mods, settings and the whitelist stay. The old world is backed up first, so it can be restored.</div>
                        @if (_confirm == "reset")
                        {
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <input class="form-control form-control-sm" style="max-width: 16rem;" placeholder="Seed (blank = random)" @bind="_resetSeed" />
                                <button class="btn btn-sm btn-warning" @onclick="() => StartAsync(Hub.ResetWorldAsync(s.Id, string.IsNullOrWhiteSpace(_resetSeed) ? null : _resetSeed))" disabled="@_running">Yes, new world</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirm = null">Cancel</button>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-warning" @onclick="@(() => { _confirm = "reset"; _resetSeed = ""; })" disabled="@_running">
                                <span class="bi bi-globe"></span> New world...
                            </button>
                        }
                    </div>

                    @* Remove *@
                    <div class="border-top pt-3">
                        <strong>Remove server</strong>
                        @if (s.IsPrimary)
                        {
                            <div class="text-muted small">@s.Name is where players arrive, so it cannot be removed.</div>
                        }
                        else
                        {
                            <div class="text-muted small mb-2">Stops @s.Name, takes it out of <code>/server</code>, and deletes it. A final backup is kept in this list's folder on the machine.</div>
                            @if (_confirm == "remove")
                            {
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <input class="form-control form-control-sm" style="max-width: 16rem;" placeholder="Type @s.Id to confirm" @bind="_removeTyped" @bind:event="oninput" />
                                    <button class="btn btn-sm btn-danger" @onclick="() => StartAsync(Hub.RemoveServerAsync(s.Id))" disabled="@(_running || _removeTyped != s.Id)">Remove @s.Name</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirm = null">Cancel</button>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="@(() => { _confirm = "remove"; _removeTyped = ""; })" disabled="@_running">
                                    <span class="bi bi-trash"></span> Remove...
                                </button>
                            }
                        }
                    </div>

                    @if (_opMessage != null)
                    {
                        <div class="alert @(_opOk ? "alert-info" : "alert-danger") mt-3 mb-0">@_opMessage</div>
                    }
                </div>
            }
        }
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Add a server</strong>
            <button class="btn btn-sm btn-outline-primary" @onclick="UseSpookyPreset" disabled="@_running">Spooky preset</button>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="_name" @bind:after="SuggestId" placeholder="Spooky" disabled="@_running" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Id (players type <code>/server @(_id == "" ? "id" : _id)</code>)</label>
                    <input class="form-control" @bind="_id" disabled="@_running" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Memory (MB)</label>
                    <input class="form-control" type="number" min="512" step="512" @bind="_memoryMb" @bind:after="CheckCapacityAsync" disabled="@_running" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Type</label>
                    <select class="form-select" @bind="_loader" @bind:after="LoadVersionsAsync" disabled="@_running">
                        <option value="Paper">Paper (plugins - anyone can join, incl. Bedrock)</option>
                        <option value="Fabric">Fabric (mods - QuestCraft runs Fabric)</option>
                        <option value="Forge">Forge (mods)</option>
                        <option value="NeoForge">NeoForge (mods)</option>
                        <option value="Vanilla">Vanilla (made as Fabric with no mods)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Minecraft version</label>
                    <select class="form-select" @bind="_gameVersion" disabled="@_running">
                        @foreach (var v in _versions) { <option value="@v">@v</option> }
                    </select>
                    <div class="form-text">QuestCraft headsets run 1.21.5.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">World seed (optional)</label>
                    <input class="form-control" @bind="_seed" disabled="@_running" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Server mods / plugins (Modrinth names, one per line)</label>
                    <textarea class="form-control font-monospace small" rows="7" @bind="_serverMods" disabled="@_running"></textarea>
                    <div class="form-text">Required libraries are added automatically. Proxy, voice chat, Bedrock and VR support are always included.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Mods players need on their own game (one per line)</label>
                    <textarea class="form-control font-monospace small" rows="7" @bind="_clientMods" disabled="@_running"></textarea>
                    <div class="form-text">The "Set up Quest" page installs these on headsets. A server with these cannot be joined from Bedrock.</div>
                </div>
            </div>

            @if (_capacityWarnings.Count > 0)
            {
                <div class="alert alert-warning mt-3 mb-0">
                    <strong>Running this alongside the servers that are up may overload the machine:</strong>
                    <ul class="mb-0">@foreach (var w in _capacityWarnings) { <li>@w</li> }</ul>
                </div>
            }

            <button class="btn btn-primary mt-3" @onclick="CreateAsync" disabled="@(_running || _id == "" || _gameVersion == "")">
                @(_running ? "Creating..." : "Create server")
            </button>
            @if (_message != null)
            {
                <div class="alert @(_messageOk ? "alert-info" : "alert-danger") mt-3">@_message</div>
            }
        </div>
    </div>

    @if (_log.Count > 0)
    {
        <div class="card">
            <div class="card-header"><strong>Progress</strong></div>
            <div class="card-body"><pre class="mb-0 small">@string.Join("\n", _log)</pre></div>
        </div>
    }
}

@code {
    private string _name = "", _id = "", _loader = "Paper", _gameVersion = "", _seed = "", _serverMods = "", _clientMods = "";
    private int _memoryMb = 2048;
    private List<string> _versions = [];
    private List<string> _capacityWarnings = [];
    private readonly List<string> _log = [];
    private bool _running;
    private string? _message;
    private bool _messageOk;
    // Manage panel: which server is open, its backups, and which destructive action awaits a second click.
    private string? _manage, _confirm, _opMessage;
    private string _resetSeed = "", _removeTyped = "";
    private bool _opOk;
    private List<BackupDto> _backups = [];

    protected override async Task OnInitializedAsync()
    {
        Hub.OnOperationProgress += OnProgress;
        Hub.OnServerListReceived += OnServers;
        await Hub.ConnectAsync();
        _log.AddRange(await Hub.GetCreateLogAsync());
        await LoadVersionsAsync();
        await CheckCapacityAsync();
    }

    private async Task LoadVersionsAsync()
    {
        _versions = await Hub.GetGameVersionsAsync(_loader);
        // Default to the version the headsets run when it is offered.
        _gameVersion = _versions.Contains("1.21.5") ? "1.21.5" : _versions.FirstOrDefault() ?? "";
    }

    private async Task CheckCapacityAsync()
    {
        var c = await Hub.GetCreateCapacityAsync(_memoryMb);
        _capacityWarnings = c?.Warnings ?? [];
    }

    private void SuggestId()
    {
        if (_id != "") return;
        _id = new string(_name.ToLowerInvariant().Select(ch => char.IsLetterOrDigit(ch) ? ch : '-').ToArray()).Trim('-');
    }

    /// <summary>Aubri's spooky server: Fabric 1.21.5 (QuestCraft), Halloween + horror mods that work in VR.</summary>
    private async Task UseSpookyPreset()
    {
        _name = "Spooky";
        _id = "spooky";
        _loader = "Fabric";
        await LoadVersionsAsync();
        _memoryMb = 3072;
        _serverMods = string.Join("\n", "from-the-fog", "server-side-horror", "sleepless-datapack", "qraftys-halloween-villages",
            "flower-mimics", "macaws-holidays", "mutant-monsters", "spooky-doors");
        _clientMods = string.Join("\n", "macaws-holidays", "mutant-monsters", "spooky-doors", "from-the-fog", "tense-ambience");
        await CheckCapacityAsync();
    }

    private async Task CreateAsync()
    {
        _running = true;
        _message = null;
        _log.Clear();
        var result = await Hub.CreateServerAsync(new CreateServerDto(_id.Trim(), _name.Trim(), _loader, _gameVersion, _memoryMb,
            [_serverMods], [_clientMods], _seed));
        _message = result.Message;
        _messageOk = result.Success;
        if (!result.Success) _running = false;
    }

    private async Task ToggleManageAsync(string id)
    {
        _confirm = null;
        _opMessage = null;
        _manage = _manage == id ? null : id;
        await LoadBackupsAsync();
    }

    private async Task LoadBackupsAsync() =>
        _backups = _manage == null ? [] : (await Hub.ListBackupsAsync(_manage)).OrderByDescending(b => b.CreatedUtc).ToList();

    /// <summary>Starts a backup/restore/new world/remove; progress and the result arrive through OnProgress.</summary>
    private async Task StartAsync(Task<ToggleResultDto> start)
    {
        _confirm = null;
        _log.Clear();
        var result = await start;
        _opMessage = result.Message;
        _opOk = result.Success;
        _running = result.Success;
    }

    private async Task DeleteBackupAsync(string serverId, string fileName)
    {
        _confirm = null;
        var result = await Hub.DeleteBackupAsync(serverId, fileName);
        _opMessage = result.Message;
        _opOk = result.Success;
        await LoadBackupsAsync();
    }

    /// <summary>The label part of {id}-yyyyMMdd-HHmmss[-label].tar.gz, in words.</summary>
    private static string BackupReason(string serverId, string fileName)
    {
        var stem = fileName.EndsWith(".tar.gz") ? fileName[..^7] : fileName;
        var rest = stem.Length > serverId.Length + 16 ? stem[(serverId.Length + 16)..].TrimStart('-') : "";
        return rest switch
        {
            "" => "Backed up",
            "before-reset" => "Before a new world",
            "removed" => "When it was removed",
            "before-proxy" => "Before the proxy was set up",
            _ => rest.Replace('-', ' '),
        };
    }

    private static string Size(long bytes) => bytes >= 1L << 30 ? $"{bytes / (double)(1L << 30):0.0} GB" : $"{bytes / (double)(1L << 20):0} MB";

    private void OnProgress(OperationProgressDto p)
    {
        _log.Add($"{DateTime.Now:HH:mm:ss} {p.Message}");
        if (p.Done)
        {
            _running = false;
            if (p.Operation == "create-server")
            {
                _message = p.Failed ? p.Message : $"{_name} is ready. In game: /server {_id}";
                _messageOk = !p.Failed;
            }
            else
            {
                _opMessage = p.Failed ? p.Message : "Done.";
                _opOk = !p.Failed;
                if (!p.Failed && _manage != null && !Hub.Servers.Any(s => s.Id == _manage)) _manage = null;
                _ = InvokeAsync(async () => { await LoadBackupsAsync(); StateHasChanged(); });
            }
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnServers(List<ServerSummaryDto> _) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Hub.OnOperationProgress -= OnProgress;
        Hub.OnServerListReceived -= OnServers;
    }
}
