@page "/plugins"
@inject ServerHubClient Hub

<PageTitle>Plugins - AubsCraft Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@AddonsTitle</h1>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-success" @onclick="StartServerAsync" disabled="@_controlBusy">
            @(_controlAction == "start" ? "Starting..." : "Start")
        </button>
        <button class="btn btn-sm btn-warning" @onclick="RestartServerAsync" disabled="@_controlBusy">
            @(_controlAction == "restart" ? "Restarting..." : "Restart")
        </button>
        <button class="btn btn-sm btn-danger" @onclick="StopServerAsync" disabled="@_controlBusy">
            @(_controlAction == "stop" ? "Stopping..." : "Stop")
        </button>
    </div>
</div>

@if (_startWarnings != null)
{
    <div class="alert alert-warning">
        <strong>Starting @Hub.SelectedServer?.Name may overload the machine:</strong>
        <ul class="mb-2">
            @foreach (var w in _startWarnings)
            {
                <li>@w</li>
            }
        </ul>
        <button class="btn btn-sm btn-warning" @onclick="StartAnywayAsync">Start anyway</button>
        <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => _startWarnings = null">Cancel</button>
    </div>
}

<!-- Tabs -->
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(_tab == "installed" ? "active" : "")" @onclick='() => _tab = "installed"'>
            Installed (@_plugins.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(_tab == "browse" ? "active" : "")" @onclick='() => _tab = "browse"'>
            Browse Modrinth
        </button>
    </li>
</ul>

@if (_tab == "installed")
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <span class="text-muted">@_plugins.Count(p => p.Enabled) enabled, @_plugins.Count(p => !p.Enabled) disabled.</span>
        <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="CheckUpdatesAsync" disabled="@_busy">
            <span class="bi bi-arrow-repeat"></span> @(_checking ? "Checking..." : "Check for updates")
        </button>
    </div>

    <div class="row">
        @foreach (var plugin in _plugins.OrderBy(p => p.Name))
        {
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card @(plugin.Enabled ? "" : "opacity-50")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-title mb-1">
                                    @plugin.Name
                                    @if (!string.IsNullOrEmpty(plugin.Version))
                                    {
                                        <small class="text-muted">v@plugin.Version</small>
                                    }
                                </h6>
                                @if (!string.IsNullOrEmpty(plugin.Description))
                                {
                                    <p class="card-text text-muted small mb-1" style="line-height: 1.3;">@Truncate(plugin.Description, 100)</p>
                                }
                                @if (!string.IsNullOrEmpty(plugin.Authors))
                                {
                                    <small class="text-muted">by @plugin.Authors</small>
                                }
                            </div>
                            <div class="form-check form-switch ms-2">
                                <input class="form-check-input" type="checkbox" checked="@plugin.Enabled"
                                       @onchange="() => ToggleAsync(plugin)" />
                            </div>
                        </div>
                        <div class="mt-1">
                            <small class="text-muted">@FormatSize(plugin.FileSize)</small>
                            @if (!plugin.Enabled)
                            {
                                <span class="badge bg-secondary ms-1">Disabled</span>
                            }
                            @if (Addon(plugin) is { } a)
                            {
                                @if (a.ClientNeeded) { <span class="badge bg-info text-dark ms-1" title="Installed on headsets by the Quest setup and in the PC mod pack">Players need it too</span> }
                                @if (a.Protected) { <span class="badge bg-dark ms-1" title="Lets players in through the proxy">AubsCraft needs this</span> }
                                @if (a.RequiredBy.Count > 0) { <span class="badge bg-light text-dark ms-1">Needed by @string.Join(", ", a.RequiredBy)</span> }
                                @if (a.ProjectId == null) { <span class="badge bg-light text-muted ms-1" title="Modrinth doesn't know this file (added by hand)">Not from Modrinth</span> }
                            }
                        </div>
                        @if (Addon(plugin) is { } act)
                        {
                            <div class="mt-2 d-flex flex-wrap gap-1">
                                @if (act.UpdateVersion != null)
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="() => UpdateAsync(act)" disabled="@_busy">
                                        <span class="bi bi-arrow-up-circle"></span> Update to @act.UpdateVersion
                                    </button>
                                }
                                @if (!act.Protected && act.RequiredBy.Count == 0)
                                {
                                    if (_confirmRemove == act.FileName)
                                    {
                                        <button class="btn btn-sm btn-danger" @onclick="() => RemoveAsync(act)" disabled="@_busy">Yes, remove</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmRemove = null">Keep</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmRemove = act.FileName" disabled="@_busy">
                                            <span class="bi bi-trash"></span> Remove
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- Modrinth Browser -->
    <div class="input-group mb-3">
        <input type="text" class="form-control" placeholder="Search for plugins..."
               @bind="_searchQuery" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" />
        <button class="btn btn-primary" @onclick="SearchAsync" disabled="@(string.IsNullOrWhiteSpace(_searchQuery) || _searching)">
            @(_searching ? "Searching..." : "Search")
        </button>
    </div>

    @if (_searchResults.Count > 0)
    {
        <div class="row">
            @foreach (var result in _searchResults)
            {
                <div class="col-md-6 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex gap-3">
                                @if (!string.IsNullOrEmpty(result.IconUrl))
                                {
                                    <img src="@result.IconUrl" alt="" style="width:48px;height:48px;border-radius:8px;" />
                                }
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">@result.Title</h6>
                                    <p class="text-muted small mb-1">@Truncate(result.Description, 120)</p>
                                    <small class="text-muted">by @result.Author - @FormatDownloads(result.Downloads) downloads</small>
                                </div>
                            </div>
                            <div class="mt-2">
                                <button class="btn btn-sm btn-success" @onclick="() => InstallFromModrinthAsync(result)"
                                        disabled="@_installing">
                                    @(_installingId == result.ProjectId ? "Installing..." : "Install Latest")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (_hasSearched)
    {
        <p class="text-muted">No plugins found. Try a different search term.</p>
    }
}

@if (!string.IsNullOrEmpty(_lastResult))
{
    <div class="alert @(_lastResultSuccess ? "alert-success" : "alert-info") alert-dismissible fade show mt-3">
        @_lastResult
        <button type="button" class="btn-close" @onclick="() => _lastResult = null"></button>
    </div>
}

@code {
    private string _tab = "installed";
    private List<PluginInfoDto> _plugins = [];
    // What Modrinth knows about each installed jar (badges, update, remove), by file name.
    private Dictionary<string, InstalledAddonDto> _addons = [];
    private bool _checking, _busy;
    private string? _confirmRemove;

    private InstalledAddonDto? Addon(PluginInfoDto p) => _addons.GetValueOrDefault(p.FileName);

    private async Task ReloadAsync(bool checkUpdates = false)
    {
        _plugins = await Hub.GetPluginsAsync();
        _addons = (await Hub.GetAddonsAsync(checkUpdates)).ToDictionary(a => a.FileName);
    }

    private async Task CheckUpdatesAsync()
    {
        _checking = _busy = true;
        await ReloadAsync(checkUpdates: true);
        var n = _addons.Values.Count(a => a.UpdateVersion != null);
        _lastResult = n == 0 ? "Everything is up to date." : $"{n} update{(n == 1 ? "" : "s")} available.";
        _lastResultSuccess = true;
        _checking = _busy = false;
    }

    private async Task UpdateAsync(InstalledAddonDto a)
    {
        _busy = true;
        var result = await Hub.UpdateAddonAsync(a.FileName);
        _lastResult = result.Message;
        _lastResultSuccess = result.Success;
        await ReloadAsync(checkUpdates: true);
        _busy = false;
    }

    private async Task RemoveAsync(InstalledAddonDto a)
    {
        _busy = true;
        _confirmRemove = null;
        var result = await Hub.RemoveAddonAsync(a.FileName);
        _lastResult = result.Message;
        _lastResultSuccess = result.Success;
        await ReloadAsync();
        _busy = false;
    }
    private string? _lastResult;
    private bool _lastResultSuccess;

    // Browse
    private string _searchQuery = "";
    private List<ModrinthSearchResultDto> _searchResults = [];
    private bool _searching;
    private bool _hasSearched;
    private bool _installing;
    private string? _installingId;

    // Server control
    private bool _controlBusy;
    private string? _controlAction;

    protected override async Task OnInitializedAsync()
    {
        await Hub.ConnectAsync();
        await ReloadAsync();
    }

    private async Task ToggleAsync(PluginInfoDto plugin)
    {
        var result = await Hub.TogglePluginAsync(plugin.FileName);
        _lastResult = result.Message;
        _lastResultSuccess = result.Success;
        await ReloadAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchQuery))
            await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery)) return;
        _searching = true;
        _searchResults = await Hub.SearchPluginsAsync(_searchQuery.Trim());
        _searching = false;
        _hasSearched = true;
    }

    private async Task InstallFromModrinthAsync(ModrinthSearchResultDto plugin)
    {
        _installing = true;
        _installingId = plugin.ProjectId;
        // The server picks the newest build for this server, adds the libraries it requires, and checks every download.
        var result = await Hub.InstallAddonAsync(plugin.ProjectId);
        _lastResult = result.Message;
        _lastResultSuccess = result.Success;
        _installing = false;
        _installingId = null;
        if (result.Success)
            await ReloadAsync();
    }

    private async Task RestartServerAsync()
    {
        _controlBusy = true;
        _controlAction = "restart";
        var result = await Hub.RestartServerAsync();
        _lastResult = result.Message;
        _lastResultSuccess = result.Success;
        _controlBusy = false;
        _controlAction = null;
    }

    private async Task StopServerAsync()
    {
        _controlBusy = true;
        _controlAction = "stop";
        var result = await Hub.StopServerAsync();
        _lastResult = result.Message;
        _lastResultSuccess = result.Success;
        _controlBusy = false;
        _controlAction = null;
    }

    // Paper servers run plugins; Fabric / Forge / NeoForge servers run mods.
    private string AddonsTitle => Hub.SelectedServer?.Loader is null or "Paper" ? "Plugins" : "Mods";

    // Capacity warnings for the pending start (null = none pending). A warning, never a block.
    private List<string>? _startWarnings;

    private async Task StartServerAsync()
    {
        var capacity = await Hub.GetStartCapacityAsync();
        if (capacity is { Warnings.Count: > 0 })
        {
            _startWarnings = capacity.Warnings;
            return;
        }
        await StartAnywayAsync();
    }

    private async Task StartAnywayAsync()
    {
        _startWarnings = null;
        _controlBusy = true;
        _controlAction = "start";
        var result = await Hub.StartServerAsync();
        _lastResult = result.Message;
        _lastResultSuccess = result.Success;
        _controlBusy = false;
        _controlAction = null;
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F0} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private static string FormatDownloads(long downloads)
    {
        if (downloads >= 1_000_000) return $"{downloads / 1_000_000.0:F1}M";
        if (downloads >= 1_000) return $"{downloads / 1_000.0:F0}K";
        return downloads.ToString();
    }

    private static string Truncate(string text, int maxLength)
    {
        if (text.Length <= maxLength) return text;
        return text[..maxLength] + "...";
    }
}
