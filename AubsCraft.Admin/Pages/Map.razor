@page "/map"
@inject ServerHubClient Hub
@inject InputService Input
@inject WorldCacheService WorldCache
@inject RenderWorkerHost WorkerHost
@inject SpawnJSRuntime JS
@inject NavigationManager Nav
@inject AubsCraft.Admin.Xr.XrViewerHost Xr
@inject AuthStateProvider Auth
@inject AubsCraft.Admin.Voice.VoiceClient Voice
@implements IDisposable
@using AubsCraft.Admin.Services
@using SpawnDev.SpawnJS
@using SpawnDev.SpawnJS.Blazor
@using SpawnDev.SpawnJS.JSObjects
@using SpawnDev.SpawnJS.WebWorkers

<PageTitle>Map - AubsCraft Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="mb-0">World Map</h1>
    <div class="d-flex gap-2 align-items-center">
        @if (_viewMode == ViewMode.Viewer3D)
        {
            @* The numbers are on the GPU HUD now. This line stays for screen readers and for the viewer gate, which reads it. *@
            <small class="text-muted font-monospace visually-hidden" style="font-size: 0.7rem;">
                @if (_lastStats != null)
                {
                    @($"{_lastStats.Fps:F0} FPS | {_lastStats.VisibleVerts / 1000}K/{_lastStats.TotalVerts / 1000}K verts | {_lastStats.VisibleChunks}/{_lastStats.TotalChunks} chunks | draw: {_lastStats.DrawDistance} | {_lastStats.ChunksPerSecond:F1} c/s | Worker | XYZ {_lastStats.CamX:F0} {_lastStats.CamY:F0} {_lastStats.CamZ:F0}")
                }
                @if (!_isPointerLocked) { <span> | Click to fly</span> }
            </small>
            @if (_vrSupported)
            {
                <button class="btn btn-sm btn-outline-success" disabled="@_xrBusy" @onclick="@(() => EnterXrAsync("immersive-vr"))">Enter VR</button>
            }
            @if (_arSupported)
            {
                <button class="btn btn-sm btn-outline-success" disabled="@_xrBusy" @onclick="@(() => EnterXrAsync("immersive-ar"))">Enter AR</button>
            }
            <button class="btn btn-sm @(_lighting ? "btn-outline-warning" : "btn-outline-secondary")" title="Light the world by the sky and block light (torches, caves) near you; off is the plainer, faster picture" @onclick="ToggleLightingAsync">Lighting: @(_lighting ? "On" : "Off")</button>
            <button class="btn btn-sm @(Voice.IsOn ? "btn-success" : "btn-outline-secondary")" title="Hear the players and the other viewers, each from where they are, and speak to them" @onclick="ToggleVoiceAsync">Voice: @(Voice.IsOn ? "On" : "Off")</button>
            @if (Voice.IsOn)
            {
                <button class="btn btn-sm @(Voice.MicOn ? "btn-danger" : "btn-outline-secondary")" title="Open the microphone: the players near where you are in the world hear you in the game" @onclick="ToggleMicAsync">Mic: @(Voice.MicOn ? "On" : "Off")</button>
            }
            @if (_voiceText.Length > 0)
            {
                <small class="text-muted">@_voiceText</small>
            }
            @if (Auth.Role is "Owner" or "Admin")
            {
                <button class="btn btn-sm @(_editing ? "btn-warning" : "btn-outline-warning")" title="Build in the world as an admin: left click breaks, right click places, middle click copies a block, Ctrl+Z undoes, B turns it on and off" @onclick="ToggleEditAsync">Edit: @(_editing ? "On" : "Off")</button>
            }
            <button class="btn btn-sm btn-outline-secondary" @onclick="SwitchToBlueMap">BlueMap</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="ClearCacheAsync">Clear Cache</button>
        }
        else if (_viewMode == ViewMode.BlueMap)
        {
            <button class="btn btn-sm btn-outline-primary" @onclick="SwitchTo3D">3D Viewer</button>
            <a href="@_blueMapUrl" target="_blank" class="btn btn-sm btn-outline-secondary">Open in New Tab</a>
        }
        else
        {
            <span class="text-muted">@_statusMessage</span>
        }
    </div>
</div>

@if (_viewMode == ViewMode.Viewer3D || _viewMode == ViewMode.Initializing)
{
    <canvas id="map-canvas" @ref="_canvasRef"
            style="width: 100%; height: calc(100vh - 8rem); border-radius: 4px; display: block; background: #a5cce8; cursor: @(_isPointerLocked ? "none" : "pointer");"
            tabindex="0"
            @onclick="OnCanvasClick"
            @oncontextmenu:preventDefault>
    </canvas>
}
else if (_viewMode == ViewMode.BlueMap && !string.IsNullOrEmpty(_blueMapUrl))
{
    <iframe src="@_blueMapUrl"
            style="width: 100%; height: calc(100vh - 8rem); border: none; border-radius: 4px;"
            allowfullscreen>
    </iframe>
}
else
{
    <div class="alert alert-info">@_statusMessage</div>
}

@code {
    private ElementRef<HTMLCanvasElement> _canvasRef;
    private string? _blueMapUrl;
    private ViewMode _viewMode = ViewMode.Initializing;
    private string _statusMessage = "Initializing...";
    private Document? _document;
    private bool _isPointerLocked;

    private IRenderWorkerService? _renderService;
    private RenderStats? _lastStats;
    private int _lastCanvasW, _lastCanvasH;
    private HTMLCanvasElement? _canvas;
    private ResizeObserver? _resizeObserver;
    private ActionCallback<ResizeObserverEntry[]>? _resizeCallback;

    private enum ViewMode { Initializing, Viewer3D, BlueMap, Error }

    protected override async Task OnInitializedAsync()
    {
        await Hub.ConnectAsync();
        Hub.OnServerStatusReceived += OnServerStatus;
        Hub.OnChatMessageReceived += OnHubChat;
        Hub.OnActivityEventReceived += OnHubActivity;
        var config = await Hub.GetBlueMapConfigAsync();
        if (config.Enabled && !string.IsNullOrEmpty(config.Url))
            _blueMapUrl = config.Url;
    }

    /// <summary>"cam=x,y,z" or "cam=x,y,z,pitch,yaw" (degrees, invariant culture) from a URL's query string.</summary>
    internal static bool TryParseCameraQuery(string uri, out (float X, float Y, float Z, float? Pitch, float? Yaw) cam)
    {
        cam = default;
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(uri).Query);
        var parts = query["cam"]?.Split(',');
        if (parts is not { Length: 3 or 5 }) return false;
        var v = new float[parts.Length];
        for (int i = 0; i < parts.Length; i++)
            if (!float.TryParse(parts[i], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out v[i])
                || !float.IsFinite(v[i]))
                return false;
        cam = (v[0], v[1], v[2], v.Length == 5 ? v[3] : null, v.Length == 5 ? v[4] : null);
        return true;
    }

    /// <summary>
    /// True when the URL's query has hudfeed=demo: the HUD is fed sample chat and players instead of the server's, a typed line is echoed
    /// back as chat instead of being sent, and F9 raises a notice. For the viewer gate and for screenshots (nothing goes to the server).
    /// </summary>
    internal static bool HudDemoByLink(string uri)
        => string.Equals(System.Web.HttpUtility.ParseQueryString(new Uri(uri).Query)["hudfeed"], "demo", StringComparison.OrdinalIgnoreCase);

    /// <summary>"time=ticks" (Minecraft ticks: 0 sunrise, 6000 noon, 12000 sunset, 18000 midnight): the viewer shows that hour and ignores the server's clock. For the gate and for screenshots.</summary>
    internal static int? TimeByLink(string uri)
        => int.TryParse(System.Web.HttpUtility.ParseQueryString(new Uri(uri).Query)["time"], System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var ticks) ? ticks : null;

    /// <summary>"dd=chunks": hold the draw distance (the fog follows it) instead of adapting it to the frame rate. For the gate and for screenshots.</summary>
    internal static int? DrawDistanceByLink(string uri)
        => int.TryParse(System.Web.HttpUtility.ParseQueryString(new Uri(uri).Query)["dd"], System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var chunks) ? chunks : null;

    /// <summary>"light=0" or "light=1": the lighting setting for this visit (it overrides the remembered one). For the gate and for screenshots.</summary>
    internal static bool? LightingByLink(string uri)
        => System.Web.HttpUtility.ParseQueryString(new Uri(uri).Query)["light"] switch { "0" => false, "1" => true, _ => null };

    private const string LightingKey = "aubscraft.lighting";
    private bool _lighting = true;

    // The remembered setting (on unless it was turned off); storage can be blocked, then it is on for this visit
    private bool ReadRememberedLighting()
    {
        try
        {
            using var storage = JS.Get<Storage>("localStorage");
            return storage.GetItem(LightingKey) != "0";
        }
        catch { return true; }
    }

    // Building (an admin's edit mode lives in the worker; B toggles it there too, so the state comes back with the stats)
    private bool _editing;

    private async Task ToggleEditAsync()
    {
        if (_renderService == null) return;
        _editing = await _renderService.SetEditModeAsync(!_editing);
        StateHasChanged();
    }

    // Voice: the players and the other viewers heard where they are, the user heard in the game (the microphone is the user's to open)
    private string _voiceText = "";

    private async Task ToggleVoiceAsync()
    {
        if (Voice.IsOn) { Voice.Stop(); _voiceText = ""; return; }
        Voice.Where = () => _lastStats == null ? System.Numerics.Vector3.Zero : new System.Numerics.Vector3(_lastStats.CamX, _lastStats.CamY, _lastStats.CamZ);
        Voice.Notice -= OnVoiceNotice;
        Voice.Notice += OnVoiceNotice;
        var uri = new Uri(Nav.BaseUri);
        var url = $"{(uri.Scheme == "https" ? "wss" : "ws")}://{uri.Authority}/api/live/voice/ws?server={Uri.EscapeDataString(Hub.SelectedServerId ?? "")}";
        await Voice.StartAsync(url);
    }

    private async Task ToggleMicAsync() => await Voice.SetMicAsync(!Voice.MicOn);

    private void OnVoiceNotice(string text)
    {
        _voiceText = text;
        InvokeAsync(StateHasChanged);
    }

    // Where the camera is and who is heard, about ten times a second while the voice is on
    private async Task UpdateVoiceAsync()
    {
        var s = await _renderService!.GetStatsAsync();
        _lastStats = s;
        float yaw = s.CamYaw * MathF.PI / 180f, pitch = s.CamPitch * MathF.PI / 180f;
        Voice.SetListener(new System.Numerics.Vector3(s.CamX, s.CamY, s.CamZ), new System.Numerics.Vector3(MathF.Cos(pitch) * MathF.Cos(yaw), MathF.Sin(pitch), MathF.Cos(pitch) * MathF.Sin(yaw)));
        var speaking = Voice.Speaking();
        var text = speaking.Count == 0 ? "" : "Speaking: " + string.Join(", ", speaking);
        if (text != _voiceText && (_voiceText.StartsWith("Speaking") || _voiceText.Length == 0)) { _voiceText = text; StateHasChanged(); }
    }
    private async Task ToggleLightingAsync()
    {
        _lighting = !_lighting;
        if (_renderService != null) await _renderService.SetLightingAsync(_lighting);
        try
        {
            using var storage = JS.Get<Storage>("localStorage");
            storage.SetItem(LightingKey, _lighting ? "1" : "0");
        }
        catch { /* the choice holds for this visit */ }
    }

    /// <summary>True when the URL's query has hud=0.</summary>
    internal static bool HudHiddenByLink(string uri)
        => System.Web.HttpUtility.ParseQueryString(new Uri(uri).Query)["hud"] == "0";

    // What SignalR delivers goes to the worker's GPU HUD (chat box, player list, notices) in batches; the worker has no connection of its own
    private readonly HudFeedBuffer _hudFeed = new();
    private bool _hudDemo;
    // Set by a time= link: the hour is fixed, the server's clock is not followed
    private int? _timeLinked;

    // A headset: the world is drawn on this thread while a session runs (XrViewerHost); the worker's own loop rests
    private bool _vrSupported, _arSupported, _xrBusy;
    private int _lastTicks = -1;

    private async Task CheckXrAsync()
    {
        try
        {
            _vrSupported = await Xr.VrSupportedAsync();
            _arSupported = await Xr.ArSupportedAsync();
            if (_vrSupported || _arSupported) { System.Console.WriteLine($"[Map] WebXR: VR {_vrSupported}, AR {_arSupported}"); StateHasChanged(); }
        }
        catch (Exception ex) { System.Console.WriteLine($"[Map] WebXR check failed: {ex.Message}"); }
    }

    private async Task EnterXrAsync(string mode)
    {
        if (_renderService == null || _xrBusy || Hub.SelectedServerId is not { } serverId) return;
        _xrBusy = true;
        try
        {
            var s = await _renderService.GetStatsAsync();
            await _renderService.SetPausedAsync(true);
            Xr.Ended -= OnXrEnded;
            Xr.Ended += OnXrEnded;
            Xr.ChatSent -= OnXrChat;
            Xr.ChatSent += OnXrChat;
            await Xr.EnterAsync(mode, serverId, new System.Numerics.Vector3(s.CamX, s.CamY, s.CamZ), s.CamYaw, s.CamPitch, _lastTicks, Auth.Role is "Owner" or "Admin");
            Xr.SeedHud(_hudFeed.CurrentPlayers, _hudFeed.RecentChat);
        }
        catch (Exception ex)
        {
            System.Console.WriteLine($"[Map] Could not enter {mode}: {ex.Message}");
            await _renderService.SetPausedAsync(false);
        }
        finally { _xrBusy = false; StateHasChanged(); }
    }

    // A quick phrase said in the headset goes to the server's chat like one typed on the desktop
    private void OnXrChat(string line)
    {
        System.Console.WriteLine($"[Map] said from the headset: {line}");
        if (_hudDemo) _hudFeed.AddChat("You", line);
        else _ = Hub.SayAsync(line);
    }

    private void OnXrEnded(System.Numerics.Vector3 head, float yaw, float pitch)
    {
        if (_renderService == null) return;
        _ = _renderService.SetCameraAsync(head.X, head.Y, head.Z, pitch, yaw);
        _ = _renderService.SetPausedAsync(false);
    }

    private bool IsForSelectedServer(string? serverId) => serverId == null || serverId == Hub.SelectedServerId;

    private void OnServerStatus(ServerStatusDto status)
    {
        if (status.TimeTicks >= 0) _lastTicks = status.TimeTicks;
        if (_timeLinked == null && status.TimeTicks >= 0 && _renderService != null)
            _ = _renderService.SetTimeOfDay(status.TimeTicks);
        if (status.Connected) _hudFeed.SetPlayers(status.Players);
    }

    private void OnHubChat(ChatMessageDto msg)
    {
        if (IsForSelectedServer(msg.ServerId)) _hudFeed.AddChat(msg.PlayerName, msg.Message);
    }

    private void OnHubActivity(ActivityEventDto evt)
    {
        if (IsForSelectedServer(evt.ServerId)) _hudFeed.AddActivity(evt);
    }

    private void OnPointerLockChange()
    {
        bool wasLocked = _isPointerLocked;
        _isPointerLocked = _document?.PointerLockElement != null;
        if (wasLocked && !_isPointerLocked)
            Input.ConsumeMouseDelta();
        // The camera has (or gave up) the mouse: the HUD's crosshair/hover follow. Compared with what the HUD was last told,
        // not with wasLocked: the input loop clears _isPointerLocked itself on Escape, before the browser's own event.
        if (_isPointerLocked != Input.PointerLocked)
        {
            Input.PointerLocked = _isPointerLocked;
            if (_renderService != null) _ = _renderService.SetPointerLockedAsync(_isPointerLocked);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _statusMessage = "Starting render worker...";
            StateHasChanged();

            // Transfer the canvas to the worker
            _canvas = _canvasRef.Get() ?? throw new InvalidOperationException("Canvas was not rendered.");
            int width = _canvas.ClientWidth;
            int height = _canvas.ClientHeight;
            _lastCanvasW = width;
            _lastCanvasH = height;
            _canvas.Width = width;
            _canvas.Height = height;
            var offscreen = _canvas.TransferControlToOffscreen();

            // ResizeObserver fires ONLY when size changes
            _resizeCallback = new ActionCallback<ResizeObserverEntry[]>(OnCanvasResized);
            _resizeObserver = new ResizeObserver(_resizeCallback);
            _resizeObserver.Observe(_canvas);

            // The worker renders ONE server's world: after a server switch, end the old server's worker.
            var serverId = Hub.SelectedServerId ?? throw new InvalidOperationException("No server is selected.");
            WorldCache.ServerId = serverId;
            if (WorkerHost.IsStarted && WorkerHost.ServerId != serverId)
            {
                System.Console.WriteLine($"[Map] Switching worlds: '{WorkerHost.ServerId}' -> '{serverId}'");
                await WorkerHost.ResetAsync();
            }

            if (WorkerHost.IsStarted)
            {
                // Worker already running from previous visit - just re-attach canvas
                _renderService = WorkerHost.Service;
                await _renderService!.AttachCanvasAsync(offscreen, width, height);
                System.Console.WriteLine("[Map] Re-attached canvas to existing worker");
            }
            else
            {
                // First visit - create worker and start everything
                var (worker, service) = await WorkerHost.EnsureWorkerAsync(offscreen, width, height);
                _renderService = service;
                System.Console.WriteLine("[Map] Render worker created, transferring canvas...");

                // Restore camera position
                float camX = 0f, camY = 200f, camZ = 0f, pitch = -90f, yaw = 0f;
                var savedCam = await WorldCache.LoadCameraPositionAsync();
                if (savedCam != null)
                {
                    (camX, camY, camZ, pitch, yaw) = savedCam.Value;
                    System.Console.WriteLine($"[Map] Restored camera: ({camX:F0}, {camY:F0}, {camZ:F0})");
                }
                else
                {
                    // First visit: start above the world spawn, not over (0, 0)
                    var spawn = await Hub.GetWorldSpawnAsync();
                    if (spawn.Known) (camX, camZ) = (spawn.X, spawn.Z);
                    System.Console.WriteLine($"[Map] Starting at world spawn: ({camX:F0}, {camZ:F0}) known={spawn.Known}");
                }

                // Deep link /map?cam=x,y,z[,pitch,yaw] wins over the saved camera and the spawn (PLANS F5).
                // First visit only: a worker that is already running keeps its camera.
                if (TryParseCameraQuery(Nav.Uri, out var linked))
                {
                    (camX, camY, camZ) = (linked.X, linked.Y, linked.Z);
                    if (linked.Pitch is { } p) pitch = p;
                    if (linked.Yaw is { } yw) yaw = yw;
                    System.Console.WriteLine($"[Map] Camera from link: ({camX:F0}, {camY:F0}, {camZ:F0}) pitch={pitch:F0} yaw={yaw:F0}");
                }

                // Deep link /map?hudfeed=demo: sample chat and players for the gate and screenshots (see HudDemoByLink)
                if (HudDemoByLink(Nav.Uri))
                {
                    _hudDemo = true;
                    _hudFeed.AddChat("Aubs", "welcome to AubsCraft!");
                    _hudFeed.AddChat("SpudArt", "a long line that has to wrap around because it is wider than the chat box allows it to be, with plenty of words in it");
                    _hudFeed.SetPlayers(["Aubs", "SpudArt", "Nikki", "Dad"]);
                }

                // Deep link /map?hud=0 hides the GPU HUD: a clean frame for streaming and capture (first visit only, like cam=)
                if (HudHiddenByLink(Nav.Uri))
                    await _renderService.SetHudVisibleAsync(false);

                await _renderService.StartAsync(serverId, camX, camY, camZ, pitch, yaw);
                await _renderService.SetAdminAsync(Auth.Role is "Owner" or "Admin");
                _lighting = LightingByLink(Nav.Uri) ?? ReadRememberedLighting();
                await _renderService.SetLightingAsync(_lighting);
                if (DrawDistanceByLink(Nav.Uri) is { } linkedDistance)
                    await _renderService.SetDrawDistanceAsync(linkedDistance);
                if (TimeByLink(Nav.Uri) is { } linkedTicks)
                {
                    _timeLinked = linkedTicks;
                    await _renderService.SetTimeOfDay(linkedTicks);
                }
                WorkerHost.IsStarted = true;
                WorkerHost.ServerId = serverId;
            }

            // Attach input service on main thread
            Input.Attach();
            // The HUD runs in the worker, which has no DOM: this side listens on the canvas and forwards what it sees
            Input.AttachCanvas(_canvas);

            // Pointer lock via event - zero per-frame JS calls
            _document = JS.Get<Document>("document");
            _document.OnPointerLockChange += OnPointerLockChange;

            _viewMode = ViewMode.Viewer3D;
            _statusMessage = "";
            StateHasChanged();

            // Main thread: input + stats only
            _ = InputAndStatsLoop();
            _ = CheckXrAsync();
        }
        catch (Exception ex)
        {
            _viewMode = ViewMode.Error;
            _statusMessage = $"GPU init failed: {ex.Message}";
            System.Console.WriteLine($"[Map] Init error: {ex}");
            if (!string.IsNullOrEmpty(_blueMapUrl))
            {
                _viewMode = ViewMode.BlueMap;
                _statusMessage = "GPU not available, using BlueMap";
            }
            StateHasChanged();
        }
    }

    /// <summary>
    /// Main thread loop: sends input to the worker, receives stats back.
    /// Zero rendering, zero GPU work, zero data processing.
    /// </summary>
    private async Task InputAndStatsLoop()
    {
        int cameraSaveCounter = 0;
        int feedCounter = 0;
        int voiceCounter = 0;
        int chatPollTicks = 0; // ticks left in which to look for a line the player just sent from the HUD chat
        while (_viewMode == ViewMode.Viewer3D && _renderService != null)
        {
            await Task.Delay(16);

            // Canvas input for the worker's GPU HUD (mouse position/buttons/wheel, keys, blur)
            if (Input.TakeUiEvents() is { } uiEvents)
            {
                await _renderService.PushUiInputAsync(uiEvents);
                // Enter may have submitted a chat line: the worker queues it on its next frame, so look for a short while
                if (uiEvents.Any(e => e.Kind == UiInputEvent.KeyDown && e.Code is "Enter" or "NumpadEnter")) chatPollTicks = 40;
                if (_hudDemo && uiEvents.Any(e => e.Kind == UiInputEvent.KeyDown && e.Code == "F9"))
                    _hudFeed.AddActivity(new ActivityEventDto(DateTime.UtcNow, ActivityEventType.Advancement, "Aubs", "Aubs has made the advancement [Stone Age]"));
            }

            if (chatPollTicks > 0)
            {
                chatPollTicks--;
                foreach (var line in await _renderService.TakeOutgoingChatAsync())
                {
                    if (_hudDemo) _hudFeed.AddChat("You", line);
                    else _ = Hub.SayAsync(line);
                }
            }

            if (Voice.IsOn && !Xr.IsActive && ++voiceCounter >= 6) { voiceCounter = 0; await UpdateVoiceAsync(); }

            // Chat, players and notices for the HUD, at most ~10 times a second
            if (++feedCounter >= 6)
            {
                feedCounter = 0;
                if (_hudFeed.HasPending)
                {
                    var feed = _hudFeed.Take();
                    await _renderService.PushHudFeedAsync(feed);
                    Xr.FeedHud(feed);   // a headset's HUD is on this thread, not in the worker
                }
            }

            if (_isPointerLocked)
            {
                if (Input.KeysDown.Contains("Escape"))
                {
                    _isPointerLocked = false;
                    Input.KeysDown.Remove("Escape");
                    continue;
                }

                var (dx, dy) = Input.ConsumeMouseDelta();
                var keysDown = Input.KeysDown;
                if (dx != 0 || dy != 0 || keysDown.Count > 0)
                    await _renderService.ProcessInputAsync(dx, dy, 0.016f, keysDown.ToArray());
            }

            cameraSaveCounter++;
            if (cameraSaveCounter >= 30)
            {
                cameraSaveCounter = 0;
                _lastStats = await _renderService.GetStatsAsync();
                _editing = _lastStats.Editing;
                // The block palette is open: the mouse is the HUD's until it closes
                if (_lastStats.WantsPointer && _isPointerLocked) _document?.ExitPointerLock();
                StateHasChanged();

                if (_lastStats != null)
                    _ = WorldCache.SaveCameraPositionAsync(
                        _lastStats.CamX, _lastStats.CamY, _lastStats.CamZ,
                        _lastStats.CamPitch, _lastStats.CamYaw);
            }
        }
    }

    private void OnCanvasResized(ResizeObserverEntry[] entries)
    {
        if (_canvas == null || _renderService == null) return;
        int cw = _canvas.ClientWidth;
        int ch = _canvas.ClientHeight;
        if (cw > 0 && ch > 0 && (cw != _lastCanvasW || ch != _lastCanvasH))
        {
            _lastCanvasW = cw;
            _lastCanvasH = ch;
            _ = _renderService.ResizeAsync(cw, ch);
        }
        foreach (var e in entries) e.Dispose();
    }

    private async void OnCanvasClick()
    {
        if (_isPointerLocked) return;
        try
        {
            // A click on the HUD (the player list, an open menu) is the HUD's: it does not take the mouse for the camera
            if (_renderService != null && OverHud(await _renderService.GetHudClickRectsAsync(), Input.MouseX, Input.MouseY)) return;
            _canvas?.RequestPointerLock();
        }
        catch { }
    }

    private static bool OverHud(float[] rects, float x, float y)
    {
        for (int i = 0; i + 3 < rects.Length; i += 4)
            if (x >= rects[i] && x < rects[i] + rects[i + 2] && y >= rects[i + 1] && y < rects[i + 1] + rects[i + 3]) return true;
        return false;
    }

    private void SwitchTo3D() => _viewMode = ViewMode.Viewer3D;
    private void SwitchToBlueMap() => _viewMode = ViewMode.BlueMap;

    private async Task ClearCacheAsync()
    {
        await WorldCache.ClearAsync();
        System.Console.WriteLine("[Map] OPFS cache cleared");
    }

    public void Dispose()
    {
        Xr.Ended -= OnXrEnded;
        Xr.ChatSent -= OnXrChat;
        Voice.Notice -= OnVoiceNotice;
        Voice.Stop();
        Hub.OnServerStatusReceived -= OnServerStatus;
        Hub.OnChatMessageReceived -= OnHubChat;
        Hub.OnActivityEventReceived -= OnHubActivity;
        // Input first: it unsubscribes its handlers from the canvas element, which must still be alive. With the element disposed
        // before this, Input.Detach threw a NullReferenceException inside Blazor's disposal queue ("Unhandled exception rendering
        // component") every time the page was left - and a server switch re-keys the page (MainLayout @key), so it did the same.
        Input.Detach();
        if (_document != null)
        {
            _document.OnPointerLockChange -= OnPointerLockChange;
            _document.Dispose();
            _document = null;
        }
        _resizeObserver?.Disconnect();
        _resizeObserver?.Dispose();
        _resizeCallback?.Dispose();
        // Detach canvas but keep worker alive - it persists via RenderWorkerHost
        if (_renderService != null)
            _ = _renderService.DetachCanvasAsync();
        _canvas?.Dispose();
    }
}
