@page "/quest"
@using System.Net.Http.Json
@using SpawnDev.SpawnJS
@using SpawnDev.SpawnJS.JSObjects
@using SpawnDev.SpawnJS.TangoADB
@inject TangoService Tango
@inject HttpClient Http
@inject SpawnJSRuntime JS
@implements IDisposable

<PageTitle>Set up QuestCraft - AubsCraft</PageTitle>

<div class="container py-4" style="max-width: 820px;">
    <h2 class="mb-1"><span class="bi bi-headset"></span> Set up your Quest</h2>
    <p class="text-muted">
        Plug your Quest 3/3S into this computer with a USB-C cable, enable Developer Mode, then connect below.
        This installs (or updates) QuestCraft and the mods AubsCraft needs - including voice chat - straight onto the headset.
    </p>

    @if (!Tango.IsWebUsbSupported)
    {
        <div class="alert alert-warning">
            This page needs WebUSB - use <b>Chrome</b>, <b>Edge</b>, or another Chromium browser on a computer (not in the headset).
        </div>
    }

    <!-- Step 1: connect -->
    <div class="card bg-dark text-light mb-3">
        <div class="card-body">
            <h5 class="card-title">1. Connect the headset</h5>
            @if (!Tango.IsConnected)
            {
                <button class="btn btn-primary" @onclick="ConnectQuest" disabled="@busy">
                    <span class="bi bi-usb-symbol"></span> Connect Quest
                </button>
                <div class="form-text">You'll see a USB chooser, then "Allow USB debugging?" inside the headset - accept both.</div>
            }
            else
            {
                <p class="mb-1"><span class="badge bg-success">Connected</span> @deviceLabel</p>
                <button class="btn btn-outline-light btn-sm" @onclick="Disconnect" disabled="@busy">Disconnect</button>
            }
        </div>
    </div>

    @if (Tango.IsConnected && manifest != null)
    {
        <!-- Step 2: QuestCraft -->
        <div class="card bg-dark text-light mb-3">
            <div class="card-body">
                <h5 class="card-title">2. QuestCraft</h5>
                @if (installedPackage == null)
                {
                    <p class="mb-2"><span class="bi bi-exclamation-triangle text-warning"></span> QuestCraft is not installed yet.</p>
                }
                else if (QuestCraftCurrent)
                {
                    <p class="mb-2"><span class="bi bi-check-circle text-success"></span> <b>Up to date</b> - v@(installedVersion) is the latest. Nothing to do here.</p>
                }
                else
                {
                    <p class="mb-2"><span class="bi bi-arrow-up-circle text-warning"></span> Installed: <code>@installedPackage</code> @(installedVersion is null ? "(version unknown)" : $"v{installedVersion}") - <b>v@(Bare(manifest.QuestCraft.Version))</b> is available.</p>
                }
                <p class="text-muted small">Latest QuestCraft: <b>@manifest.QuestCraft.Version</b> (@manifest.QuestCraft.Filename)</p>
                <button class="btn @(QuestCraftCurrent ? "btn-outline-light btn-sm" : "btn-primary")" @onclick="InstallQuestCraft" disabled="@busy">
                    <span class="bi bi-box-arrow-down"></span> @(installedPackage == null ? "Install QuestCraft" : QuestCraftCurrent ? "Reinstall QuestCraft" : "Update QuestCraft")
                </button>
            </div>
        </div>

        <!-- Step 3: mods -->
        <div class="card bg-dark text-light mb-3">
            <div class="card-body">
                <h5 class="card-title d-flex align-items-center">
                    <span>3. Mods on the headset</span>
                    @if (installedPackage != null)
                    {
                        <button class="btn btn-outline-light btn-sm ms-auto" @onclick="RefreshMods" disabled="@busy" title="Read the headset's mods folder again">
                            <span class="bi bi-arrow-clockwise"></span> Refresh
                        </button>
                    }
                </h5>
                @if (installedPackage == null)
                {
                    <p class="text-muted">Install QuestCraft first, then add the mods.</p>
                }
                else if (rows == null)
                {
                    <p class="text-muted">Reading the headset's mods folder...</p>
                }
                else
                {
                    @if (ToInstall.Count == 0)
                    {
                        <div class="alert alert-success py-2 mb-2"><span class="bi bi-check-circle"></span> <b>All set.</b> Every mod the AubsCraft servers need is on the headset and up to date.</div>
                    }
                    else
                    {
                        <div class="alert alert-warning py-2 mb-2"><span class="bi bi-exclamation-triangle"></span> @ToInstall.Count mod@(ToInstall.Count == 1 ? "" : "s") to install or update.</div>
                    }
                    <div class="table-responsive">
                        <table class="table table-dark table-sm align-middle mb-2">
                            <thead><tr><th>Mod</th><th>For</th><th>Status</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var row in rows)
                                {
                                    <tr>
                                        <td>
                                            @row.Name @if (row.Version != null) { <span class="text-muted small">@row.Version</span> }
                                            <div class="text-muted small"><code>@row.File</code></div>
                                        </td>
                                        <td class="small">@row.For</td>
                                        <td><span class="badge @row.Badge">@row.StatusText</span></td>
                                        <td class="text-end text-nowrap">
                                            @if (row.CanRemove)
                                            {
                                                if (pendingRemove == row.File)
                                                {
                                                    <button class="btn btn-danger btn-sm" @onclick="() => RemoveMod(row.File)" disabled="@busy">Yes, remove</button>
                                                    <button class="btn btn-outline-light btn-sm" @onclick="() => pendingRemove = null">Keep</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => pendingRemove = row.File" disabled="@busy" title="Delete this jar from the headset">
                                                        <span class="bi bi-trash"></span> Remove
                                                    </button>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="text-muted small">Folder: <code>@ModsDir()</code></p>
                    <button class="btn @(ToInstall.Count > 0 ? "btn-primary" : "btn-outline-light btn-sm")" @onclick="InstallMods" disabled="@busy">
                        <span class="bi bi-cloud-arrow-up"></span>
                        @(ToInstall.Count > 0 ? $"Install / update {ToInstall.Count} mod{(ToInstall.Count == 1 ? "" : "s")}" : "Reinstall all")
                    </button>
                }
            </div>
        </div>

        <!-- Step 4: one-time in-headset setting -->
        <div class="card bg-dark text-light mb-3">
            <div class="card-body">
                <h5 class="card-title">4. Turn on voice (one time, in the headset)</h5>
                <p class="mb-1">Put the headset on, launch <b>QuestCraft</b>, and join the server. Then:</p>
                <ol class="mb-1">
                    <li>Press the <b>B</b> button on the right controller to open the menu.</li>
                    <li>Open <b>Voice Chat Menu</b>.</li>
                    <li>Change the activation from <i>Push to Talk</i> to <b>Voice Activated</b>.</li>
                </ol>
                <p class="text-muted small mb-0">A speaker icon appears above your head when voice is active. (You'll hear "some modules could not be loaded" on join - that's a harmless QuestCraft message; voice still works.)</p>
            </div>
        </div>
    }

    @if (busy)
    {
        <div class="d-flex align-items-center gap-2 mb-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>@busyLabel</span>
        </div>
    }

    @if (log.Count > 0)
    {
        <div class="card bg-black text-light">
            <div class="card-body">
                <pre class="mb-0" style="white-space:pre-wrap;font-size:.85rem;color:#9be29b;">@string.Join("\n", log)</pre>
            </div>
        </div>
    }
</div>

@code {
    ManifestDto? manifest;
    string deviceLabel = "";
    string? installedPackage;
    string? installedVersion;
    string? instance;
    List<ModRow>? rows;
    string? pendingRemove;
    bool busy;
    string busyLabel = "";
    readonly List<string> log = new();

    protected override async Task OnInitializedAsync()
    {
        Tango.ConnectionChanged += OnConnectionChanged;
        try { manifest = await Http.GetFromJsonAsync<ManifestDto>("api/quest/manifest"); }
        catch (Exception ex) { Log($"Could not load install manifest: {ex.Message}"); }
    }

    void OnConnectionChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Tango.ConnectionChanged -= OnConnectionChanged;

    string ModsDir() => manifest == null || installedPackage == null
        ? ""
        : manifest.ModsDirTemplate.Replace("{package}", installedPackage).Replace("{instance}", instance ?? "1.21.5");

    /// <summary>"v6.0.0" and "6.0.0" are the same version.</summary>
    static string Bare(string? v) => (v ?? "").Trim().TrimStart('v', 'V');
    bool QuestCraftCurrent => installedPackage != null && manifest != null && installedVersion != null
        && Bare(installedVersion) == Bare(manifest.QuestCraft.Version);

    List<ModDto> ToInstall => rows == null ? [] : rows.Where(r => r.Mod != null && r.Status is ModStatus.Missing or ModStatus.Outdated).Select(r => r.Mod!).ToList();

    enum ModStatus { Current, Outdated, Unverified, Missing, Unused, QuestCraft, Other }

    record ModRow(string File, string Name, string? Version, string For, ModStatus Status, ModDto? Mod)
    {
        public string StatusText => Status switch
        {
            ModStatus.Current => "Up to date",
            ModStatus.Outdated => "Update available",
            ModStatus.Unverified => "Installed",
            ModStatus.Missing => "Not installed",
            ModStatus.Unused => "No longer needed",
            ModStatus.QuestCraft => "QuestCraft's own",
            _ => "Added by hand",
        };
        public string Badge => Status switch
        {
            ModStatus.Current or ModStatus.Unverified => "bg-success",
            ModStatus.Outdated or ModStatus.Missing => "bg-warning text-dark",
            ModStatus.Unused => "bg-secondary",
            ModStatus.QuestCraft => "bg-info text-dark",
            _ => "bg-secondary",
        };
        // QuestCraft's own mods are its to manage (it re-adds them); AubsCraft's are reinstalled with the button.
        public bool CanRemove => Status is ModStatus.Unused or ModStatus.Other;
    }

    static string Norm(string s) => new string(s.ToLowerInvariant().Where(char.IsLetterOrDigit).ToArray());

    /// <summary>A folder or file name safe inside single quotes in the headset's shell.</summary>
    static string Quote(string s) => s.Contains('\'') ? throw new InvalidOperationException($"Unexpected file name: {s}") : $"'{s}'";

    /// <summary>
    /// Reads the headset's mods folder and compares every jar with what the servers need: sha512 on the headset
    /// (toybox sha512sum) against Modrinth's published hash, so "Up to date" means byte-identical.
    /// </summary>
    async Task ReadHeadsetMods()
    {
        if (Tango.Adb == null || manifest == null || installedPackage == null) { rows = null; return; }
        var dir = ModsDir();
        var shell = Tango.Adb.Subprocess.NoneProtocol;
        var listing = await shell.SpawnWaitText($"ls -1 {Quote(dir)} 2>/dev/null");
        var files = listing.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(f => f.EndsWith(".jar", StringComparison.OrdinalIgnoreCase)).ToList();
        var hashes = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (files.Count > 0)
        {
            var sums = await shell.SpawnWaitText($"cd {Quote(dir)} && sha512sum *.jar 2>/dev/null");
            foreach (var line in sums.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                var parts = line.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                if (parts.Length == 2 && parts[0].Length == 128) hashes[parts[1].TrimStart('*')] = parts[0].ToLowerInvariant();
            }
        }

        var list = new List<ModRow>();
        foreach (var mod in manifest.Mods)
        {
            var target = string.IsNullOrEmpty(mod.TargetFilename) ? mod.Filename : mod.TargetFilename;
            var onDevice = files.FirstOrDefault(f => string.Equals(f, target, StringComparison.OrdinalIgnoreCase));
            var status = onDevice == null ? ModStatus.Missing
                : string.IsNullOrEmpty(mod.Sha512) || !hashes.TryGetValue(onDevice, out var h) ? ModStatus.Unverified
                : string.Equals(h, mod.Sha512, StringComparison.OrdinalIgnoreCase) ? ModStatus.Current : ModStatus.Outdated;
            list.Add(new ModRow(target, mod.Name, mod.Version, mod.For, status, mod));
        }
        var managed = manifest.QuestCraftManaged.Select(Norm).ToList();
        foreach (var f in files.Where(f => !list.Any(r => string.Equals(r.File, f, StringComparison.OrdinalIgnoreCase))))
        {
            var name = Path.GetFileNameWithoutExtension(f);
            if (f.StartsWith("aubscraft-", StringComparison.OrdinalIgnoreCase))
                list.Add(new ModRow(f, name, null, "A server that no longer uses it", ModStatus.Unused, null));
            else if (managed.Any(m => Norm(name).Contains(m)))
                list.Add(new ModRow(f, name, null, "QuestCraft (VR, performance)", ModStatus.QuestCraft, null));
            else
                list.Add(new ModRow(f, name, null, "-", ModStatus.Other, null));
        }
        rows = list.OrderBy(r => r.Status switch { ModStatus.Missing or ModStatus.Outdated => 0, ModStatus.Current or ModStatus.Unverified => 1, ModStatus.QuestCraft => 3, _ => 2 })
            .ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase).ToList();
        if (hashes.Count == 0 && files.Count > 0) Log("(this headset has no sha512sum - mods show as Installed without a version check)");
    }

    async Task RefreshMods() => await Run("Reading the headset's mods...", ReadHeadsetMods);

    async Task RemoveMod(string file)
    {
        pendingRemove = null;
        if (Tango.Adb == null) return;
        await Run($"Removing {file}...", async () =>
        {
            await Tango.Adb.Subprocess.NoneProtocol.SpawnWaitText($"rm -f {Quote(ModsDir() + "/" + file)}");
            Log($"Removed {file}.");
            await ReadHeadsetMods();
        });
    }

    async Task ConnectQuest()
    {
        await Run("Connecting...", async () =>
        {
            var adb = await Tango.RequestAndConnect("AubsCraft Quest Setup");
            if (adb == null) { Log("No device selected."); return; }
            var model = await adb.GetProp("ro.product.model");
            deviceLabel = $"{model} ({adb.Serial})";
            Log($"Connected to {deviceLabel}.");
            await DetectQuestCraft(adb);
        });
    }

    async Task DetectQuestCraft(Adb adb)
    {
        installedPackage = null; installedVersion = null; rows = null;
        var listText = await adb.Subprocess.NoneProtocol.SpawnWaitText("pm list packages");
        var packages = listText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(l => l.StartsWith("package:") ? l["package:".Length..] : l).ToList();
        installedPackage = packages.FirstOrDefault(p => manifest!.PackageHints.Any(h => p.Contains(h, StringComparison.OrdinalIgnoreCase)));
        if (installedPackage != null)
        {
            Log($"QuestCraft detected: {installedPackage}");
            try
            {
                var dump = await adb.Subprocess.NoneProtocol.SpawnWaitText($"dumpsys package {installedPackage} | grep versionName");
                var idx = dump.IndexOf("versionName=", StringComparison.Ordinal);
                if (idx >= 0) installedVersion = dump[(idx + "versionName=".Length)..].Split('\n', '\r', ' ')[0].Trim();
            }
            catch { }
            // Detect the QCXR instance folder (e.g. "1.21.5") that holds the mods dir.
            try
            {
                var ls = await adb.Subprocess.NoneProtocol.SpawnWaitText($"ls /sdcard/Android/data/{installedPackage}/files/instances/");
                instance = ls.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).FirstOrDefault();
                if (instance != null) Log($"QuestCraft instance: {instance} (mods -> {ModsDir()})");
            }
            catch { }
            await ReadHeadsetMods();
        }
        else Log("QuestCraft not installed yet.");
    }

    async Task InstallQuestCraft()
    {
        if (Tango.Adb == null || manifest == null) return;
        await Run("Installing QuestCraft (this can take a minute)...", async () =>
        {
            Log($"Streaming {manifest.QuestCraft.Filename} to the headset...");
            using var response = await JS.Fetch($"api/quest/asset/{manifest.QuestCraft.Id}");
            if (!response.Ok) { Log($"Download failed (HTTP {response.Status})."); return; }
            using var body = response.Body!;
            var pm = new PackageManager(Tango.Adb);
            var result = await pm.PushAndInstallStream(body, new PackageManagerInstallOptions { SkipExisting = false });
            Log(string.IsNullOrWhiteSpace(result) ? "QuestCraft installed." : result.Trim());
            await DetectQuestCraft(Tango.Adb);
        });
    }

    async Task InstallMods()
    {
        if (Tango.Adb == null || manifest == null || installedPackage == null) return;
        await Run("Installing mods...", async () =>
        {
            var dir = ModsDir();
            var mods = ToInstall.Count > 0 ? ToInstall : manifest.Mods;
            var sync = await Tango.Adb.Sync();
            try
            {
                foreach (var mod in mods)
                {
                    Log($"Pushing {mod.Filename}...");
                    using var response = await JS.Fetch($"api/quest/asset/{mod.Id}");
                    if (!response.Ok) { Log($"  download failed (HTTP {response.Status})."); continue; }
                    using var body = response.Body!;
                    var targetName = string.IsNullOrEmpty(mod.TargetFilename) ? mod.Filename : mod.TargetFilename;
                    await sync.Write(new AdbSyncWriteOptions { Filename = $"{dir}/{targetName}", File = body });
                    Log($"  {mod.Name} installed as {targetName}.");
                }
            }
            finally { await sync.Release(); sync.Dispose(); }

            // Ensure QuestCraft has microphone permission - voice chat can't transmit without it
            // (QuestCraft doesn't request it itself; this replaces the manual SideQuest grant step).
            try
            {
                Log("Granting microphone permission...");
                await Tango.Adb.Subprocess.NoneProtocol.SpawnWaitText($"pm grant {installedPackage} android.permission.RECORD_AUDIO");
                Log("  Microphone permission granted.");
            }
            catch (Exception ex) { Log($"  (could not grant mic permission automatically: {ex.Message})"); }

            await ReadHeadsetMods();
            Log(ToInstall.Count == 0 ? "Done! Every mod is up to date. One step left in the headset - see below." : $"{ToInstall.Count} mod(s) still not current - see the list.");
        });
    }

    async Task Disconnect() => await Run("Disconnecting...", () => Tango.Disconnect());

    async Task Run(string label, Func<Task> action)
    {
        busy = true; busyLabel = label; StateHasChanged();
        try { await action(); }
        catch (Exception ex) { Log($"[error] {ex.Message}"); }
        finally { busy = false; busyLabel = ""; StateHasChanged(); }
    }

    void Log(string msg) { log.Add(msg); InvokeAsync(StateHasChanged); }

    class ManifestDto
    {
        public QuestCraftDto QuestCraft { get; set; } = new();
        public List<ModDto> Mods { get; set; } = new();
        public string ModsDirTemplate { get; set; } = "";
        public List<string> PackageHints { get; set; } = new();
        public List<string> QuestCraftManaged { get; set; } = new();
    }
    class QuestCraftDto { public string Id { get; set; } = ""; public string Version { get; set; } = ""; public string Filename { get; set; } = ""; }
    class ModDto { public string Id { get; set; } = ""; public string Name { get; set; } = ""; public string Version { get; set; } = ""; public string Filename { get; set; } = ""; public string TargetFilename { get; set; } = ""; public long Size { get; set; } public string? Sha512 { get; set; } public string For { get; set; } = ""; }
}
